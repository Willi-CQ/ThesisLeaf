{
  "name": "thesisleaf",
  "version": "2.1.1",
  "private": true,
  "description": "ThesisLeaf – lokaler LaTeX-Editor und Schreibwerkstatt für Bachelorarbeiten",
  "author": "ThesisLeaf",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"node server/start.js\" \"vite\"",
    "server": "node server/start.js",
    "client": "vite",
    "build": "vite build",
    "start": "node server/start.js --open",
    "desktop": "node scripts/desktop-dev.js",
    "desktop:build": "vite build && electron-builder --win",
    "desktop:dir": "vite build && electron-builder --win --dir",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "express": "^4.21.2",
    "nspell": "^2.1.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "dompurify": "^3.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "marked": "^18.0.0",
    "mermaid": "^12.0.0",
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "de.thesisleaf.app",
    "productName": "ThesisLeaf",
    "copyright": "ThesisLeaf",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "build/icon.*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "template",
        "to": "template",
        "filter": [
          "**/*",
          "!**/.local-overleaf/**"
        ]
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "*.md"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ThesisLeaf",
      "language": "1031"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
